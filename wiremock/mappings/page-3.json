{
  "request": {
    "method": "GET",
    "urlPath": "/products",
    "queryParameters": {
      "category": {
        "equalTo": "skincare"
      },
      "page": {
        "equalTo": "3"
      }
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Cache-Control": "no-store"
    },
    "bodyFileName": "catalog/page-3.json"
  }
}
